# Public browser configuration only. Never place service_role or secret keys here.
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_VERSION=0.9.0-rc.1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values must be provisioned in the hosting secret store when a
# server-side use case is introduced. Do not prefix private values with NEXT_PUBLIC_.

# Supabase Edge Function secret/configuration. Configure in Supabase, never expose with NEXT_PUBLIC_.
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
